# ===== 本地配置（含真实密钥，绝不入库）=====
application-local.yml
.env
.env.local
*.local.yml

# ===== FISCO BCOS 证书（sdk.key 是私钥，绝不入库）=====
# 证书由建链脚本生成在 nodes/<ip>/sdk/ 下，需拷到后端运行的 conf/ 目录
*.crt
*.key
# 但允许示例证书目录结构说明文件入库
!*.example.crt
conf/
nodes/

# ===== Node =====
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# ===== Java / Maven =====
backend/target/
# 注意：.mvn/wrapper/maven-wrapper.jar 必须入库，否则别人克隆后 mvnw 无法运行

# ===== IDE =====
.idea/
*.iml
.vscode/
*.code-workspace

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 日志 =====
*.log
logs/

# ===== 用户上传（自定义头像等）=====
# 运行时产物，不入库；目录由后端启动时自动创建
uploads/
